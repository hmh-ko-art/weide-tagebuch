# FlockMap Server-Konfiguration – nach .env kopieren und ausfüllen (.env NIE ins Git!)

# Hostname, unter dem die App erreichbar ist. DNS-A-Eintrag muss auf die Server-IP zeigen.
#   Eigene Domain:      DOMAIN=flockmap.de            (A-Eintrag @ -> Server-IP)
#   Mit www:            DOMAIN="flockmap.de, www.flockmap.de"   (zusätzlich A-Eintrag www -> Server-IP)
#   Ohne eigene Domain: DOMAIN=<IP-mit-Bindestrichen>.sslip.io  (z. B. 203-0-113-10.sslip.io)
DOMAIN=flockmap.de

# Öffentliche Adresse für Admin-, Einladungs- und Freischalt-Links (App + Server). Leer = aktuelle Adresse.
# Erst setzen, wenn DOMAIN live mit HTTPS erreichbar ist.
APP_BASIS=https://flockmap.de

# Datenbank-Passwort – lang und zufällig, z. B.:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional: Google Maps statt OpenStreetMap (wird beim Bauen eingebacken)
VITE_GOOGLE_MAPS_API_KEY=

# Backups (deploy/backup.sh)
BACKUP_DIR=/srv/flockmap-backups
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_WEEKS=8

# Betreiber-Schlüssel für die Seite /?betreiber (neuen Hof anlegen). Lang und zufällig, z. B.: openssl rand -hex 24
# Leer = Hof-Anlage abgeschaltet (bestehende Höfe und Karten funktionieren trotzdem).
FLOCKMAP_ADMIN_TOKEN=

# Geheimnis für die Hashes der Lizenzcodes (lang und zufällig: openssl rand -hex 32). NIE ändern, sonst werden offene Codes ungültig.
# Leer = abgeleitet aus FLOCKMAP_ADMIN_TOKEN (dann den Admin-Token nicht mehr wechseln, solange Codes offen sind).
FLOCKMAP_LIZENZ_PEPPER=
