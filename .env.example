# Google Maps (optional). Ohne Key: Esri-Satellit / OpenStreetMap. Navigation immer über Google-Maps-Link (keine Routen in der App).
# Benötigt: Maps JavaScript API in einem Google-Cloud-Projekt mit Abrechnungskonto.
VITE_GOOGLE_MAPS_API_KEY=
# Optional: eigene Map-ID (für Advanced Markers), sonst DEMO_MAP_ID
VITE_GOOGLE_MAP_ID=
# 7s-1: öffentliche Adresse für Links (Admin-/Einladungs-/Freischalt-Links), z. B. https://flockmap.de
# Leer = Adresse, unter der die App gerade läuft (Render bleibt so erreichbar). Erst setzen, wenn die Domain auf den Server zeigt.
VITE_APP_BASIS=

# --- Server (Render-Umgebung bzw. deploy/.env) ---
# APP_BASIS=https://flockmap.de          # Basis für Freischalt-Links in /api/betreiber/lizenzen (sonst Anfrage-Adresse)
# FLOCKMAP_LIZENZ_PEPPER=<zufällig, 32+ Zeichen>   # Geheimnis für Code-Hashes; ohne: abgeleitet vom FLOCKMAP_ADMIN_TOKEN
# FLOCKMAP_LIZENZ_STICHTAG=2026-11-23T12:00:00Z   # Karten, die vorher angelegt wurden, gelten als Bestand (frei)
# FLOCKMAP_KARTEN_FREI=1                 # nur Entwicklung/Test: geteilte Karten ohne Lizenz erlauben
