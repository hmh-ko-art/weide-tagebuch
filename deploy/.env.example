# FlockMap Server-Konfiguration – nach .env kopieren und ausfüllen (.env NIE ins Git!)

# Hostname, unter dem die App erreichbar ist. DNS-A-Eintrag muss auf die Server-IP zeigen.
#   Eigene Subdomain:  DOMAIN=karte.heckernatur.de
#   Ohne eigene Domain: DOMAIN=<IP-mit-Bindestrichen>.sslip.io  (z. B. 203-0-113-10.sslip.io)
DOMAIN=karte.heckernatur.de

# Datenbank-Passwort – lang und zufällig, z. B.:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional: Google Maps statt OpenStreetMap (wird beim Bauen eingebacken)
VITE_GOOGLE_MAPS_API_KEY=

# Backups (deploy/backup.sh)
BACKUP_DIR=/srv/flockmap-backups
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_WEEKS=8
